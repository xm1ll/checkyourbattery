#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 ICON "battery.ico"
1 24 "widget.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 236, 165
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", IDC_DEVICE_LABEL, 12, 10, 212, 12
    CONTROL "", IDC_DEVICES, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER, 12, 25, 212, 96
    LTEXT "", IDC_EMPTY, 12, 31, 212, 26
    CONTROL "", IDC_PERCENT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 135, 100, 16
    PUSHBUTTON "", IDC_QUIT, 115, 135, 49, 16
    PUSHBUTTON "", IDC_DONE, 170, 135, 54, 16
END
